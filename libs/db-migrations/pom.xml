<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fondaria</groupId>
        <artifactId>libs</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>db-migrations</artifactId>
    <packaging>jar</packaging>

    <name>db-migrations</name>
    <description>The platform's Flyway migration tree, shared by every service that connects to the database</description>

    <properties>
        <!--
            No dependency here means no JUnit engine on this module's own test
            classpath. The root pom's surefire pluginManagement sets
            excludedGroups on every module, and group filtering needs an engine
            to resolve against, so with none present surefire fails hard
            ("groups/excludedGroups require TestNG, JUnit48+ or JUnit 5") instead
            of reporting "no tests to run". This module can never have test
            sources (see below), so skipping is the permanent, correct state,
            not a workaround for a temporary gap.
        -->
        <maven.test.skip>true</maven.test.skip>

        <!--
            The Flyway CLI plugin's version. Kept in step with the flyway-core
            version spring-boot-dependencies manages (3.5.16 → 11.7.2), so the CI
            `flyway:validate` resolves migrations exactly as a running service
            does. Not a dependency pin (nothing here is on a service classpath),
            so it does not risk the reactor split libs/testing/pom.xml warns of.
        -->
        <flyway-maven-plugin.version>11.7.2</flyway-maven-plugin.version>
        <postgresql.jdbc.version>42.7.11</postgresql.jdbc.version>

        <!--
            The database `flyway:validate` runs against in CI. Overridden by the
            `migrations` job's Postgres service; the default is a developer's
            local `make up` database, so `mvn -pl libs/db-migrations flyway:migrate`
            works with no arguments.
        -->
        <flyway.url>jdbc:postgresql://localhost:5432/funds</flyway.url>
        <flyway.user>funds</flyway.user>
        <flyway.password>funds_dev_pass</flyway.password>
    </properties>

    <build>
        <plugins>
            <!--
                phase-05 Task 5.1: "flyway validate passes in CI". The `migrations`
                CI job runs `flyway:migrate` then `flyway:validate` against a throwaway
                Postgres — proving the whole tree applies from empty and that no merged
                file has drifted from its recorded checksum (docs/ENGINEERING-RULES.md §4). Not bound to
                a lifecycle phase: `make verify` must not need a database.
            -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway-maven-plugin.version}</version>
                <configuration>
                    <url>${flyway.url}</url>
                    <user>${flyway.user}</user>
                    <password>${flyway.password}</password>
                    <locations>
                        <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
                    </locations>
                    <cleanDisabled>true</cleanDisabled>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.jdbc.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway-maven-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <!--
        Resources only — no Java, no dependencies, no test sources.

        The four schemas of ADR-0011 are one shared database, not one per
        service, so the migration tree describing them cannot belong to any
        single service. It lived in contribution-api only because that was the
        first service to need a table; Task 20.3 added a second service that
        reads reference.fund, and a service depending on another service's jar
        to see the schema would be a worse coupling than this module.

        Moved here by `git mv` with no file edited: Flyway records a migration
        by its path relative to the `db/migration` location root and by its
        checksum, and both are unchanged, so a database already carrying this
        history still validates (docs/ENGINEERING-RULES.md §4 — a versioned migration is never
        edited after merge).

        Version numbers are therefore a single global sequence across every
        service, and one Flyway history table records them all. A service that
        needs a new table adds the next version here.
    -->

</project>
