<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fondaria</groupId>
        <artifactId>services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>statement-worker</artifactId>
    <packaging>jar</packaging>

    <name>statement-worker</name>
    <description>The statement worker pool — the fan-out that turns a signed-off month-end close into one content-hashed monthly statement per participant (phase-07, Task 7.5b; ADR-0022)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Task 11.2: real spans/metrics to the OTel Collector. Version
            managed by the root pom's spring-boot-dependencies BOM (Spring
            Boot 3.5's Micrometer Tracing / OTel bridge), the same convention
            already used for lettuce-core below.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <exclusions>
                <!--
                    Spring Framework 6's spring-aop jar bundles these same
                    org.aopalliance classes directly; the standalone jar
                    micrometer-tracing still pulls duplicates them, which
                    the root pom's banDuplicateClasses enforcer rule catches.
                -->
                <exclusion>
                    <groupId>aopalliance</groupId>
                    <artifactId>aopalliance</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
            Two roles, one dependency: the scheduler consumes close.signed-off.v1
            (eod-job's Task 7.5a event) and produces statement.jobs.v1; the workers
            consume statement.jobs.v1. ADR-0022 keeps this service on Redpanda —
            docs/ENGINEERING-RULES.md §5 is still pinned to it until row 30b lands — and Section 2b
            of that ADR names this exact pair as the cost row 30b inherits if 7.5b
            lands first, which the platform owner confirmed on 2026-09-05.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!--
            Lettuce directly, not spring-boot-starter-data-redis, matching
            valuation-api's RedisNavSnapshotStore reasoning: the completion counter
            is one Lua script (SADD-then-INCR, ADR-0022 Section 3) and a handful of
            plain commands. A template and serializer stack over that is
            scaffolding, not design. Version managed by spring-boot-dependencies.
        -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- Money, Units, Nav, FundId, OrganizationId, ParticipantId, StorableClock. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            No ledger-client and no ledger-tigerbeetle, unlike eod-job. ADR-0022
            §4 pins every number this service renders to two sources this service
            already reads directly: the 7.4 snapshot object (opening and closing
            value) and workflow.allotment joined to reference.fund_nav
            (contributions). Neither is the ledger, so this service never opens a
            TigerBeetle connection.
        -->

        <!-- The shared Flyway tree. workflow.statement_run (V30) is added there by this task. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>db-migrations</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            The S3 API client, for object storage only — docs/ENGINEERING-RULES.md §4 bans cloud
            provider SDKs and carves out exactly this. Reads the 7.4 snapshot
            objects and writes the rendered statement objects, both to the object store,
            never AWS. Both default HTTP clients are excluded and
            url-connection-client supplied instead, for the reasons
            contribution-api's and eod-job's poms record.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RabbitMQ test helpers, driven against the real RabbitMqFixture. -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shared Testcontainers fixtures: integration tests never hand-run a database. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
