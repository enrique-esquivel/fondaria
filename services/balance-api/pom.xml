<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fondaria</groupId>
        <artifactId>services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>balance-api</artifactId>
    <packaging>jar</packaging>

    <name>balance-api</name>
    <description>The read side — a participant's holdings valued at the live NAV, from the ledger and an in-memory price cache, never from PostgreSQL (Task 6.2)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Task 11.2: real spans/metrics to the OTel Collector. Version
            managed by the root pom's spring-boot-dependencies BOM (Spring
            Boot 3.5's Micrometer Tracing / OTel bridge), the same convention
            already used for lettuce-core below.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <exclusions>
                <!--
                    Spring Framework 6's spring-aop jar bundles these same
                    org.aopalliance classes directly; the standalone jar
                    micrometer-tracing still pulls duplicates them, which
                    the root pom's banDuplicateClasses enforcer rule catches.
                -->
                <exclusion>
                    <groupId>aopalliance</groupId>
                    <artifactId>aopalliance</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Money, Units, Nav, Money.value, FundId, OrganizationId, ParticipantId. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- FundNav and FundNavRepository: the contract this service's read-only implementation
             satisfies so the NAV cache has something to converge on. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>rules-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- NavCache / InMemoryNavCache / CachedNav (Task 20.6). The price half of the balance. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>valuation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- LedgerPort and AccountIdDeriver: the units half. Read-only here — this service
             never creates an account and never posts a transfer. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>ledger-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>ledger-tigerbeetle</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The shared Flyway tree. master.participant.participant_id is added there by this
             task's V22 and read here. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>db-migrations</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Version deliberately not pinned: spring-boot-dependencies manages Flyway. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            No Redis, no object store. Unlike valuation-api, the NAV cache here is a pure
            reader and converges on reference.fund_nav within its sweep interval; a snapshot
            store would buy only a faster first sweep on a cold start, which already requires
            the database because Flyway migrates before this service serves anything.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shared Testcontainers fixtures: integration tests never hand-run a database. -->
        <dependency>
            <groupId>dev.fondaria</groupId>
            <artifactId>testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Arrives via the object-store fixture's S3 client; its classes are also in
                     spring-jcl, which the root pom's banDuplicateClasses rule catches. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!--
                                The runnable jar is `<artifact>-exec.jar`; the plain
                                jar stays the module's main artifact. Without a
                                classifier, repackage REPLACES the main artifact with
                                the executable one, whose classes live under
                                BOOT-INF/classes and are therefore invisible to any
                                module that depends on this one - which libs/e2e-tests
                                does, at test scope (ADR-0016).
                            -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
