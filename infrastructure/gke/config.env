# Settings for the throwaway GKE load-test environment (ADR-0036). Sourced by
# every script in this directory. Override any value from the environment, e.g.
#   GKE_TTL_HOURS=3 make gke-up
#
# Nothing here is a credential. The project id is derived per run and written
# to infrastructure/gke/.state (gitignored), so down.sh deletes exactly the
# project up.sh created.

# Billing account to charge (`gcloud billing accounts list`). Required; no default.
GKE_BILLING_ACCOUNT="${GKE_BILLING_ACCOUNT:-}"

# Project ids are globally unique; a random suffix is appended per run.
GKE_PROJECT_PREFIX="${GKE_PROJECT_PREFIX:-fondaria-load}"

GKE_REGION="${GKE_REGION:-us-central1}"
# The control plane is zonal (the GKE free tier covers one zonal cluster's
# management fee); nodes span three zones, matching the prod overlay's
# DoNotSchedule zone spread.
GKE_ZONE="${GKE_ZONE:-us-central1-a}"
GKE_NODE_ZONES="${GKE_NODE_ZONES:-us-central1-a,us-central1-b,us-central1-c}"
GKE_CLUSTER="${GKE_CLUSTER:-fondaria}"
# Stable channel; the version actually installed is printed by up.sh and
# recorded in .state.
GKE_RELEASE_CHANNEL="${GKE_RELEASE_CHANNEL:-stable}"

# Node pools. Counts are PER ZONE (gcloud --num-nodes semantics with three
# node zones): 2 x 3 = 6 stateful nodes, because the prod overlay requires each
# of TigerBeetle's 6 replicas on its own node (podAntiAffinity on hostname).
GKE_STATEFUL_MACHINE="${GKE_STATEFUL_MACHINE:-n2-standard-4}"
GKE_STATEFUL_NODES_PER_ZONE="${GKE_STATEFUL_NODES_PER_ZONE:-2}"
GKE_STATELESS_MACHINE="${GKE_STATELESS_MACHINE:-n2-standard-4}"
GKE_STATELESS_NODES_PER_ZONE="${GKE_STATELESS_NODES_PER_ZONE:-1}"

# Network ranges. The services range MUST contain 10.96.100.100-105: the base
# pins TigerBeetle's six replicas to those fixed ClusterIPs (base/tigerbeetle/
# service.yaml), the kind default range. GKE's default range would reject them.
GKE_SUBNET_RANGE="${GKE_SUBNET_RANGE:-10.10.0.0/20}"
GKE_PODS_RANGE="${GKE_PODS_RANGE:-10.64.0.0/14}"
GKE_SERVICES_RANGE="${GKE_SERVICES_RANGE:-10.96.0.0/16}"
GKE_MASTER_RANGE="${GKE_MASTER_RANGE:-172.16.0.0/28}"

# Dead man's switch: Cloud Scheduler deletes the whole project this many hours
# after up.sh starts, whether or not down.sh ever runs.
GKE_TTL_HOURS="${GKE_TTL_HOURS:-5}"

# Billing-account-wide budget alert (emails the billing admins; it does not
# stop spending). Created once, kept after the project is deleted.
GKE_BUDGET_USD="${GKE_BUDGET_USD:-25}"
