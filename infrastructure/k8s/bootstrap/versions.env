# Every cluster-level component the platform's manifests assume exists, pinned.
# Sourced by up.sh. Bump here, nowhere else. Each is an upstream release
# manifest applied verbatim -- the platform does not fork or hand-write
# operator installs (the previous infrastructure/k8s/operators/*.yaml were
# 70-line Deployments with no CRDs or RBAC and could never have reconciled).
KIND_NODE_IMAGE=kindest/node:v1.31.9@sha256:b94a3a6c06198d17f59cca8c6f486236fa05e2fb359cbd75dabbfc348a10b211
CALICO_VERSION=v3.29.3
CALICO_MANIFEST=https://raw.githubusercontent.com/projectcalico/calico/v3.29.3/manifests/calico.yaml
METRICS_SERVER_VERSION=v0.7.2
METRICS_SERVER_MANIFEST=https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.7.2/components.yaml
CNPG_VERSION=1.25.2
CNPG_MANIFEST=https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.25/releases/cnpg-1.25.2.yaml
RABBITMQ_OPERATOR_VERSION=v2.15.0
RABBITMQ_OPERATOR_MANIFEST=https://github.com/rabbitmq/cluster-operator/releases/download/v2.15.0/cluster-operator.yml
# Task 10.1 (ADR-0028, O-9): install.yaml bundles the Gateway API CRDs
# (experimental channel: GatewayClass, Gateway, HTTPRoute, GRPCRoute,
# ReferenceGrant, TCPRoute, TLSRoute, UDPRoute) plus Envoy Gateway's own CRDs
# and controller -- one manifest, like the three operators above.
ENVOY_GATEWAY_VERSION=v1.3.0
ENVOY_GATEWAY_MANIFEST=https://github.com/envoyproxy/gateway/releases/download/v1.3.0/install.yaml
# Task 10.4 (ADR-0028/ADR-0029): Linkerd's control-plane manifest is rendered
# by the `linkerd` CLI at bootstrap time (it must be stamped with a trust
# anchor/issuer certificate -- no plain release-manifest URL exists to pin
# here the way the operators above are pinned). up.sh checks for `linkerd`
# alongside kind/kubectl instead; there is deliberately no LINKERD_VERSION
# line -- see up.sh's own comment at the install step.
