# PostgreSQL database username
POSTGRES_USER=funds

# PostgreSQL database password
POSTGRES_PASSWORD=funds_dev_pass

# PostgreSQL database name
POSTGRES_DB=funds

# PostgreSQL external port mapping
POSTGRES_PORT=5432

# JDBC URL services connect to, as seen from inside the compose network.
# Required: a service with this unset fails to start, naming the variable.
POSTGRES_URL=jdbc:postgresql://postgres:5432/funds

# How long a connection attempt may take before it fails
POSTGRES_CONNECT_TIMEOUT=5s

# Upper bound on pooled connections per service instance. projection-worker needs at least
# PROJECTION_ENTRIES_QUEUE_COUNT + PROJECTION_TRANSFER_CONSUMERS + 2 (22 with the defaults) and
# refuses to start below that; run it with POSTGRES_MAX_POOL_SIZE=24 (its own default when unset).
POSTGRES_MAX_POOL_SIZE=10

# Redis auth password
REDIS_PASSWORD=funds_dev_pass

# Redis external port mapping
REDIS_PORT=6379

# Redis URL services connect to, as seen from inside the compose network.
# Deliberately carries NO credentials: the password is supplied separately, so
# a connection target can be logged without logging a secret.
# Required: a service with this unset fails to start, naming the variable.
REDIS_URL=redis://redis:6379

# Explicit per-command timeout for every Redis call. Short on purpose — Redis
# is a cache here, and waiting on it is worse than missing it.
REDIS_COMMAND_TIMEOUT=1s

# How long a resolved cash receipt stays replayable from cache (Task 3.3,
# docs/DESIGN-DECISIONS.md). Correctness never depends on it: with Redis stopped, the
# ledger's derived transfer id still refuses the duplicate.
CASH_RECEIPT_CACHE_TTL=24h

# Task 11.2: how long contribution-api's transferId -> traceparent correlation
# entry survives in Redis, so projection-worker can link its span to the
# originating HTTP request's trace across the CDC boundary. Short on purpose —
# a miss only degrades a trace, never correctness.
TRACE_CORRELATION_TTL=5m

# Task 11.2: projection-worker's OWN Redis connection for reading the entry
# above. Optional (unlike REDIS_URL) — absence disables trace-boundary linking
# entirely rather than failing startup, since this deliberately minimal
# service ("kill it at any instant, it converges") has no business requirement
# on Redis. MUST resolve to the same Redis instance as REDIS_URL above, or
# every read here is a permanent miss.
TRACE_CORRELATION_REDIS_URL=redis://redis:6379
TRACE_CORRELATION_REDIS_PASSWORD=funds_dev_pass
TRACE_CORRELATION_REDIS_COMMAND_TIMEOUT=200ms

# RabbitMQ admin username
RABBITMQ_DEFAULT_USER=funds

# RabbitMQ admin password
RABBITMQ_DEFAULT_PASS=funds_dev_pass

# RabbitMQ AMQP port mapping
RABBITMQ_PORT=5672

# RabbitMQ management dashboard port mapping
RABBITMQ_MANAGEMENT_PORT=15672

# How many times a bridge.ledger message may be redelivered before RabbitMQ
# dead-letters it to bridge.ledger.dlq on its own (Task 4.1's quorum queue
# x-delivery-limit — no consumer-side retry counting). Operational tuning,
# not a secret.
RABBITMQ_BRIDGE_LEDGER_DELIVERY_LIMIT=5

# ---------------------------------------------------------------------------
# CDC job (Task 4.2) — `tigerbeetle amqp`, the transport hop TigerBeetle → RabbitMQ
#
# TigerBeetle's native CDC connector (ADR-0003), streaming every committed
# ledger movement onto the `tigerbeetle` exchange. Not a service this
# repository wrote — the container is the stock TigerBeetle image; the retry
# loop around it is infrastructure/compose/cdc/run.sh. Kubernetes runs
# replicas: 2 (ADR-0007), arbitrated by RabbitMQ's exclusive locker queue,
# never by code. Reads TIGERBEETLE_ADDRESSES / TIGERBEETLE_CLUSTER_ID above,
# and RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS above for the AMQP hop.
# ---------------------------------------------------------------------------

# AMQP hop target, host or host:port. Host only by default — `tigerbeetle
# amqp` speaks plaintext AMQP 0-9-1 over TCP; the pinned 0.17.4 has no TLS in
# its AMQP client at all (see infrastructure/compose/cdc/README.md for the
# sidecar that implies in a real deployment).
CDC_AMQP_HOST=rabbitmq

# AMQP virtual host. This deployment only ever uses the default.
CDC_AMQP_VHOST=/

# Exchange the job publishes to. Must already exist — declared by the
# rabbitmq-topology one-shot (Task 4.1). The job validates it passively at
# startup and exits if it is missing.
CDC_PUBLISH_EXCHANGE=tigerbeetle

# Replay override, NOT steady-state config. Empty = resume from the last
# acknowledged event (the normal case). 0 = replay the entire ledger from the
# beginning. Any other value = resume from that TigerBeetle timestamp.
CDC_TIMESTAMP_LAST=

# The retry loop's fixed pause between restarts of `tigerbeetle amqp`. The
# instance that loses the locker-queue race exits non-zero by design; this
# short fixed interval keeps it a warm standby that reclaims the lock in
# roughly this many seconds when the active instance dies, instead of backing
# off exponentially into a cold standby. Fixed, not exponential — that is the
# "cap". Operational tuning, not a secret.
CDC_RETRY_INTERVAL_SECONDS=2

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# CDC fanout (Task 4.3 / ADR-0022, services/amqp-fanout)
#
# Consumes bridge.ledger from RabbitMQ (Task 4.1), explodes each TigerBeetle
# change event into one transfer message and two entry messages, and publishes
# them to RabbitMQ exchanges:
# - ledger.transfers.v1 (fanout exchange)
# - ledger.entries.v1 (x-consistent-hash exchange, routed by account_id)
# acknowledging the AMQP message only after publisher confirms. A pure
# transform — one system in, one system out, no database.
#
# Not a compose service: like contribution-api / valuation-api / allotment-job
# it is a plain Spring Boot jar. Values below are its local-dev defaults, as
# seen from inside the compose network.
# ---------------------------------------------------------------------------

# RabbitMQ connection. Host is REQUIRED — a fanout service that cannot name its
# broker must fail to start, not idle against localhost.
BRIDGE_AMQP_HOST=rabbitmq
BRIDGE_AMQP_PORT=5672
BRIDGE_AMQP_USERNAME=funds
BRIDGE_AMQP_PASSWORD=funds_dev_pass
BRIDGE_AMQP_VHOST=/

# How many unacknowledged bridge.ledger messages the listener may hold at
# once. Bounded so a cold start does not load the whole backlog into heap.
BRIDGE_AMQP_PREFETCH=64
# Competing consumers on bridge.ledger (1 = one ordered stream; 4 measured ~3x throughput on kind). Row 26g.
BRIDGE_AMQP_CONCURRENCY=4
# Each consumer takes up to BATCH_SIZE messages at once (at most the prefetch),
# publishes all their records, awaits the confirms together and acknowledges
# the batch with one multiple-ack. BATCH_WAIT bounds how long a partial batch
# waits for more on an idle feed.
BRIDGE_AMQP_BATCH_SIZE=32
BRIDGE_AMQP_BATCH_WAIT=10ms

# How long to wait for RabbitMQ to confirm produced records before
# giving up and letting RabbitMQ redeliver. The incoming AMQP message is never
# acknowledged until every one is confirmed. Operational tuning, not a secret.
BRIDGE_PRODUCER_CONFIRM_TIMEOUT=30s

# How long to pause after a producer failure before nacking the message back
# onto the queue, so an outage does not become a hot redelivery loop.
BRIDGE_PRODUCER_RETRY_BACKOFF=1s

# ---------------------------------------------------------------------------
# Projection worker (Phase 5 / ADR-0022, services/projection-worker)
#
# The CDC projection consumer. Reads ledger.transfers.v1 / ledger.entries.v1
# from RabbitMQ and maintains the append-only `projection` schema (V20, V21).
# Kill it at any instant, any number of times — it converges to exactly the
# right state. On a message it cannot decode it dead-letters the bytes and
# HALTS: a gap in a financial projection is worse than downtime (docs/ENGINEERING-RULES.md §4).
#
# Not a compose service: a plain Spring Boot jar, like the other services. It
# connects as a role that is a member of fondaria_cdc — the role with INSERT on
# the projection tables and UPDATE/DELETE on projection_consumer_checkpoint. Reuses POSTGRES_URL
# / POSTGRES_USER / POSTGRES_PASSWORD above, and the CALENDAR_* variables below
# (Task 5.4 stamps booking_date / value_date from the same BusinessCalendar the
# other three services use — the values must not drift).
# ---------------------------------------------------------------------------

# RabbitMQ connection. Host is REQUIRED.
PROJECTION_AMQP_HOST=rabbitmq
PROJECTION_AMQP_PORT=5672
PROJECTION_AMQP_USERNAME=funds
PROJECTION_AMQP_PASSWORD=funds_dev_pass
PROJECTION_AMQP_VHOST=/

# The phase-04 contract exchange and queue names. The defaults are the contract; override
# only for a migration or a test.
PROJECTION_TRANSFERS_EXCHANGE=ledger.transfers.v1
PROJECTION_ENTRIES_EXCHANGE=ledger.entries.v1
PROJECTION_DEAD_LETTER_QUEUE=ledger.entries.dlq
PROJECTION_TRANSFERS_QUEUE=projection.transfers.v1
PROJECTION_ENTRIES_QUEUE_PREFIX=projection.entries.v1

# Number of consistent-hash queues (projection.entries.v1.0..N-1).
PROJECTION_ENTRIES_QUEUE_COUNT=16

# Batched consumption (ADR-0034, amended by row 26w): each entries queue has its own
# container with one exclusive consumer, active on exactly one process at a time (the others
# stand by). This is the number of competing batch consumers on the transfers queue, which is
# insert-only. One transaction and one acknowledgement per batch. Each active consumer holds a
# pool connection for its batch: startup fails unless
# PROJECTION_ENTRIES_QUEUE_COUNT + PROJECTION_TRANSFER_CONSUMERS <= POSTGRES_MAX_POOL_SIZE - 2.
PROJECTION_TRANSFER_CONSUMERS=4
# Most deliveries per batch, and how long a consumer waits to fill one.
PROJECTION_BATCH_SIZE=200
PROJECTION_BATCH_TIMEOUT=100ms

# Bounded prefetch: how many unacknowledged messages one consumer may hold.
PROJECTION_PREFETCH=50

# Transient-failure retry: the first backoff, and the cap it grows to. Retries
# never stop (a gap is worse than downtime) — only the interval is bounded.
PROJECTION_RETRY_INITIAL_BACKOFF=1s
PROJECTION_RETRY_MAX_BACKOFF=30s

# How long to wait for the one dead-letter record to be confirmed before
# halting anyway.
PROJECTION_DEAD_LETTER_TIMEOUT=10s

# ADR-0032: per-consumer checkpoint rows. A consumer that advanced within the
# active window counts toward the projection head (MIN); rows idle longer than
# the retention are deleted. Retention must exceed the window.
# This process's name in its checkpoint consumer ids (<instance>/<consumer tag>).
# Kubernetes sets it to the pod name; blank locally falls back to a random id.
PROJECTION_INSTANCE_ID=
PROJECTION_CHECKPOINT_ACTIVE_WINDOW=5m
PROJECTION_CHECKPOINT_RETENTION=1h
# How often every projection-worker replica reads the cluster-wide halt flag
# (workflow.projection_halt, ADR-0032 §2): the bound on how long another replica keeps
# consuming after one halts.
PROJECTION_HALT_POLL_INTERVAL=1s

# How often every projection-worker replica logs one INFO summary of what it
# consumed, which entries queues it owns, its CDC lag and each projection
# queue's ready depth (ADR-0035).
PROJECTION_ACTIVITY_LOG_INTERVAL=1m

# Object store (SeaweedFS, ADR-0031) admin S3 credential: the object store
# itself and the object-store-buckets one-shot read these.
OBJECT_STORE_ROOT_ACCESS_KEY=funds
OBJECT_STORE_ROOT_SECRET_KEY=funds_dev_pass


# S3 API endpoint services connect to, as seen from inside the compose network.
# Required: a service with this unset fails to start, naming the variable.
OBJECT_STORE_ENDPOINT=http://object-store:8333

# S3 credentials contribution-api signs with. Same values as the object store
# admin credential above for local development only; a real environment issues a scoped
# key that can read and write objects in the bucket and nothing else.
# Required: a service with these unset fails to start, naming the variable.
OBJECT_STORE_ACCESS_KEY=funds
OBJECT_STORE_SECRET_KEY=funds_dev_pass

# SigV4 signing region. The object store ignores it, but a signature needs one.
OBJECT_STORE_REGION=us-east-1

# Bucket contribution files (dispersion files) are uploaded to, ADR-0009.
# Provisioned by the `object-store-buckets` one-shot in docker-compose.yml —
# contribution-api never creates a bucket.
# Required: a service with this unset fails to start, naming the variable.
CONTRIBUTION_FILE_BUCKET=contribution-files

# How long a presigned upload URL stays valid. It is a write grant, so short.
CONTRIBUTION_UPLOAD_URL_TTL=15m

# Largest contribution file read into memory. Generous — a dispersion file can
# carry hundreds of thousands of rows — but never unbounded, because the size
# is chosen by the caller. 64 MiB.
CONTRIBUTION_FILE_MAX_BYTES=67108864

# Explicit per-call timeout for every object-store call
OBJECT_STORE_CALL_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Contribution batch validation (Task 3.4)
#
# Submission returns 202 and validation runs afterwards (ADR-0009). These are
# operational tuning, not secrets: a deployment that sets none of them
# validates correctly, only on this cadence.
# ---------------------------------------------------------------------------

# Delay between validation sweeps
BATCH_VALIDATION_POLL_INTERVAL=5s

# Most batches one sweep claims
BATCH_VALIDATION_BATCH_SIZE=10

# How long a batch may sit in VALIDATING before another sweep may reclaim it.
# This is what makes a process dying mid-validation recoverable. Must
# comfortably exceed the time to fetch, parse and check the largest file
# expected, or a slow validation is reclaimed underneath itself.
BATCH_VALIDATION_STALE_AFTER=10m

# Most rows one part of a split file may hold (ADR-0017).
#
# NOT ONLY TUNING. A part is allotted as one linked chain, and a linked chain
# cannot exceed 8,189 transfers — that is TigerBeetle's one-megabyte message
# body, and a chain must fit in a single request or it could not be atomic. A
# file with more rows than this is divided into parts, each of which is a batch
# with its own status. 4,093 is the ceiling for a file carrying an employee and
# an employer lot on every row; a part is bounded again by its actual transfer
# count, so a file that also carries voluntary lots produces smaller parts.
BATCH_VALIDATION_MAX_ROWS_PER_PART=4093

# Object store (SeaweedFS) S3 API port mapping
OBJECT_STORE_PORT=8333

# Keycloak admin username
KEYCLOAK_ADMIN=admin

# Keycloak admin password
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass

# Keycloak HTTP port mapping
KEYCLOAK_PORT=8180

# TigerBeetle server port mapping
TIGERBEETLE_PORT=3000

# TigerBeetle cluster ID
TIGERBEETLE_CLUSTER_ID=0

# TigerBeetle replica index
TIGERBEETLE_REPLICA_ID=0

# TigerBeetle replica addresses, as seen by services (not by the container).
# Comma-separated host:port, one entry per replica, in replica-ordinal order —
# a TigerBeetle client is given every replica, not one load-balanced address.
# Local development runs a single replica; production lists all six.
# Required: a service with this unset fails to start, naming the variable.
TIGERBEETLE_ADDRESSES=tigerbeetle:3000

# Per-endpoint TCP connect timeout for the ledger readiness probe
TIGERBEETLE_CONNECT_TIMEOUT=1s

# How long a ledger readiness probe result is cached before re-checking
LEDGER_PROBE_CACHE_TTL=5s

# Explicit per-call timeout for every ledger call
TIGERBEETLE_CALL_TIMEOUT=5s

# Logical name of the cluster this deployment's ledger ids resolve to
# (ADR-0005). v1 runs a single cluster; a second one is configuration.
LEDGER_CLUSTER_NAME=primary

# ---------------------------------------------------------------------------
# Derivation namespaces
#
# Both are UUIDs, and both MUST NEVER CHANGE once any organization has been
# registered or any ledger account exists. Every organization id and every
# ledger account id is derived from them, so a new value re-derives every id
# and strands every existing balance under ids nothing will look up again.
#
# The values below are for local development only. Each real environment
# generates its own, once, and keeps it forever.
# ---------------------------------------------------------------------------

# Namespace organization ids are derived under
ORGANIZATION_ID_NAMESPACE=9a7c1e40-2f6b-4d3a-9c15-6b0d1f8e4a21

# Namespace ledger account and transfer ids are derived under
LEDGER_ID_NAMESPACE=3f2b8d16-71c4-4a58-8e0f-2d9a5c73b184

# ---------------------------------------------------------------------------
# Valuation ingestion (Task 20.3, valuation-api)
#
# Receives what an external investment platform reports a fund's pooled assets
# are worth, validates it, and records it for the NAV strike (Task 20.4).
# Reuses ADR-0009's transport, so the object-store connection variables above
# are shared — only the bucket differs.
# ---------------------------------------------------------------------------

# Bucket valuation files are uploaded to. A SEPARATE bucket from the
# contribution one: different producers (an investment platform, not an
# employer), different retention, different access. Sharing one would mean a
# credential scoped to valuations could list employers' payroll files.
# Provisioned by the deployment — valuation-api never creates a bucket.
# Required: a service with this unset fails to start, naming the variable.
VALUATION_FILE_BUCKET=valuation-files

# How long a presigned upload URL stays valid. It is a write grant, so short.
VALUATION_UPLOAD_URL_TTL=15m

# Largest valuation file read into memory. Far smaller than the contribution
# limit — a valuation file is one row per fund per date — but never unbounded,
# because the size is chosen by the caller. 4 MiB.
VALUATION_FILE_MAX_BYTES=4194304

# Delay between validation sweeps, and how many batches one sweep claims
VALUATION_POLL_INTERVAL=5s
VALUATION_BATCH_SIZE=10

# How long a batch may sit in VALIDATING before another sweep may reclaim it
VALUATION_STALE_AFTER=10m

# How far back the ageing report looks, in business dates. Bounded: an
# unbounded walk would re-examine every business date since each fund's
# inception on every call.
VALUATION_AGEING_WINDOW_BUSINESS_DATES=30

# How late a valuation must be before it is logged as a warning. One business
# date is normal — a provider delivering this morning's file this afternoon is
# not an incident — so the default gives a day of grace.
VALUATION_AGEING_ALERT_BUSINESS_DATES=2

# How often the ageing alert sweep runs. An ageing report nobody opens is not
# a control, which is why this runs on a schedule and not only on request.
VALUATION_AGEING_ALERT_INTERVAL=15m

# ---------------------------------------------------------------------------
# NAV cache (Task 20.6)
#
# The current NAV per fund, held in memory in every service that values a
# holding. reference.fund_nav is the price of record; this converges on it.
# ---------------------------------------------------------------------------

# Redis, as a WARM-START CONVENIENCE ONLY — never authoritative. Unlike
# REDIS_URL above (which backs cash-receipt idempotency replay and is
# required), leaving this unset is a supported configuration: the cache reads
# reference.fund_nav instead and every acceptance criterion still holds.
# Set it and NAV_CACHE_REDIS_PASSWORD becomes required too — a URL without a
# password would fail every command and be swallowed as an outage, which is
# exactly the silent degradation that should be loud at startup instead.
NAV_CACHE_REDIS_URL=redis://redis:6379
NAV_CACHE_REDIS_PASSWORD=funds_dev_pass

# Per-command timeout. Short: this is a cache, and waiting on it is worse
# than missing it.
NAV_CACHE_REDIS_COMMAND_TIMEOUT=1s

# ---------------------------------------------------------------------------
# Allotment run (Task 21.2, services/allotment-job)
#
# Turns a staged contribution batch into units, at a struck NAV, atomically.
# Reads TIGERBEETLE_*, POSTGRES_*, LEDGER_ID_NAMESPACE and CALENDAR_* above —
# every one of them must equal the value contribution-api and valuation-api
# are configured with, or this service resolves different accounts or a
# different dealing date than the one a batch was actually staged under.
# ---------------------------------------------------------------------------

# Delay between allotment sweeps, and how many STAGED batches one sweep
# claims. Operational tuning, not a secret — both have working defaults.
ALLOTMENT_POLL_INTERVAL=5s
ALLOTMENT_BATCH_SIZE=10

# How long an instance may go before it picks up a price struck by another
# instance. The instance that struck it refreshes that fund immediately, so
# this bounds convergence for every *other* instance.
NAV_CACHE_REFRESH_INTERVAL=10s

# How old a published price may be before it is served MARKED STALE — served,
# never withheld, and never silently. Over 24 hours because NAV is daily
# (O-21): yesterday's price on a normal morning is expected; a provider that
# has gone quiet for more than a day is not.
NAV_CACHE_STALE_AFTER=26h

# ---------------------------------------------------------------------------
# Business calendar (Task 7.1)
#
# Which dates a fund is valued on. Shared by every service that needs a
# business date.
# ---------------------------------------------------------------------------

# The platform's time zone, and the cut-off after which a timestamp belongs to
# the next business date.
CALENDAR_ZONE=America/Mexico_City
CALENDAR_CUTOFF_TIME=18:00

# Comma-separated YYYY-MM-DD dates that are not business dates.
#
# STOPGAP. Task 7.1 specifies Mexican banking and market holidays as
# effective-dated reference data, and that table does not exist yet. Until it
# does, an empty list means weekends are the only non-business dates — so a
# valuation dated on a Mexican public holiday would be accepted. Recorded as a
# known gap rather than hidden.
CALENDAR_HOLIDAYS=

# ---------------------------------------------------------------------------
# balance-api (Task 6.2)
#
# The read side: a participant's holdings valued at the live NAV. Reads
# TIGERBEETLE_*, POSTGRES_*, LEDGER_ID_NAMESPACE and NAV_CACHE_REFRESH_INTERVAL
# / NAV_CACHE_STALE_AFTER above — LEDGER_ID_NAMESPACE in particular must be the
# identical value contribution-api and allotment-job use, or every participant
# is reported as holding nothing.
#
# No NAV_CACHE_REDIS_* here: unlike valuation-api, this service's NAV cache is
# a pure reader and converges on reference.fund_nav on its own interval.
# ---------------------------------------------------------------------------

# How many participantId -> (organizationId, internalRef) resolutions one
# instance holds in memory. That mapping is immutable, so a cached entry can
# never go stale — the bound exists only to keep a very large tenant from
# growing the heap without limit. It is also what makes the balance read
# survive a PostgreSQL outage: a participant already resolved needs no
# database at all, and eviction costs one indexed lookup, never a wrong answer.
BALANCE_PARTICIPANT_CACHE_MAX=100000

# Cadence for the business-metrics telemetry snapshot sweep in balance-api (Task 30.10).
# Non-authoritative observational metrics exported to Prometheus.
BUSINESS_METRICS_REFRESH_INTERVAL=15s

# ---------------------------------------------------------------------------
# balance-api movement history (Task 6.3)
# ---------------------------------------------------------------------------

# The key the movement-history pagination cursor is signed with. A cursor is
# opaque and tamper-checked: an edited one is refused with 400 rather than
# obeyed, and the signature also binds the cursor to the participant and the
# filters it was issued for. There is deliberately no default in
# application.yaml — a signing key committed to a repository signs nothing.
#
# Must be identical across every balance-api instance (a cursor issued by one
# is presented to another) and at least 32 characters. Rotating it invalidates
# outstanding cursors, which clients recover from by starting a new page.
#
# LOCAL DEVELOPMENT VALUE ONLY. Generate a production one with, for example,
# `openssl rand -base64 48`, and supply it as a secret.
QUERY_CURSOR_SECRET=local_dev_cursor_signing_key_not_for_production

# ---------------------------------------------------------------------------
# Participant identity encryption (Task 9.5, contribution-api)
#
# The master key (KEK) wrapping every participant's own AES-256 data key.
# Base64-encoded, 32 bytes once decoded (AES-256). Rotating this value
# crypto-shreds every participant whose data key was wrapped under the
# previous one -- there is no re-wrapping migration, by design: a master key
# this codebase can silently re-wrap under is a master key an attacker who
# obtained the old one could also re-wrap under.
#
# LOCAL DEVELOPMENT VALUE ONLY. Generate a production one with, for example,
# `openssl rand -base64 32`, and supply it as a secret (never a default --
# docs/ENGINEERING-RULES.md §4).
# ---------------------------------------------------------------------------
PARTICIPANT_IDENTITY_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Upper bound on a single application statement, driver-enforced (docs/ENGINEERING-RULES.md §4 —
# every external call has an explicit timeout). The movement history is the first
# request path in this service that reads PostgreSQL on every call, and an
# unbounded one turns a slow database into parked virtual threads. Applies to
# application queries only: Flyway's migrations run on the same pool and must not
# be bounded by a request-shaped budget.
POSTGRES_QUERY_TIMEOUT=5s

# ---------------------------------------------------------------------------
# balance-api organization summary (Task 6.5)
#
# No new variable. The endpoint reads TIGERBEETLE_*, POSTGRES_*,
# LEDGER_ID_NAMESPACE and the NAV_CACHE_* settings above, plus CALENDAR_ZONE
# — which balance-api now reads for the first time.
#
# CALENDAR_ZONE decides one thing here and nothing else: which calendar month
# "contributions this period" covers, and therefore the periodStart/periodEnd
# the response carries. This service builds no BusinessCalendar, so
# CALENDAR_CUTOFF_TIME and CALENDAR_HOLIDAYS are deliberately not read by it.
# It must be the same zone the other services use, or an employer's period
# boundary moves depending on which service they ask.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# eod-job — the daily close (Task 7.2, ADR-0018)
#
# Reads TIGERBEETLE_*, POSTGRES_*, LEDGER_ID_NAMESPACE and CALENDAR_* above.
# LEDGER_ID_NAMESPACE matters more here than anywhere else: the tie-out re-derives
# every participant holding account and every pooled cash account from it. A value
# that differs from allotment-job's by one byte looks up accounts that do not
# exist, reads the whole platform as holding nothing, and reports a break on every
# fund — which is the failure mode least likely to be read as a configuration error.
#
# This service reads the ledger and never writes it, so it needs no
# LEDGER_CLUSTER_NAME of its own beyond the shared one.
# ---------------------------------------------------------------------------

# How often the internal reconciliation pass runs. The close needs one pass a day;
# a shorter interval simply re-ties a book that has not changed.
RECONCILIATION_POLL_INTERVAL=1h

# How many account ids are read from the ledger per request. Bounded by what one
# ledger message body carries — the same 8,189 that bounds a linked chain
# (LedgerLimits, ADR-0017), because it is the same megabyte. A larger value fails
# startup rather than being truncated: a truncated read is indistinguishable from
# participants holding nothing.
RECONCILIATION_ACCOUNT_LOOKUP_BATCH=8189

# How many (organization, participant, fund) holdings are drawn from
# workflow.allotment per keyset page. Bounds memory, never correctness.
RECONCILIATION_HOLDING_PAGE_SIZE=50000

# ADR-0038: a pass is skipped while the projection is behind the ledger's head.
# A projection consumer quiet for QUIET_PERIOD has drained its queue; when no
# consumer has advanced for STALL_AFTER the pass runs anyway, so a stuck
# projection still records its breaks.
RECONCILIATION_CATCH_UP_QUIET_PERIOD=15s
RECONCILIATION_CATCH_UP_STALL_AFTER=2m

# Custodian reconciliation (Task 7.3, ADR-0019). How often the pass runs.
CUSTODIAN_RECONCILIATION_POLL_INTERVAL=1h

# Days a real break (units or cash, unexplained by a statement's own pending-trade
# figure) may stay open before it escalates.
CUSTODIAN_REAL_BREAK_ESCALATION_DAYS=3

# Days a timing difference (explained by a pending trade, expected) may stay open
# before it escalates. Longer than the real-break threshold: a trade legitimately
# takes a day or more to settle.
CUSTODIAN_TIMING_DIFFERENCE_ESCALATION_DAYS=5

# Dense daily snapshot (Task 7.4). How often the pass runs. A re-run for a date
# already snapshotted re-derives the file, finds the same content hash and stores
# nothing — so a short interval costs work but never a second artefact.
SNAPSHOT_POLL_INTERVAL=1h

# How many holdings one page of the snapshot's keyset scan covers. This is the unit
# of work for all three of the pass's reads — the scan itself, the as-of units query
# and the cost-basis range — so it bounds memory, never correctness. Smaller than
# RECONCILIATION_HOLDING_PAGE_SIZE because each holding here carries its lots and a
# rendered position, not just a key.
SNAPSHOT_HOLDING_PAGE_SIZE=10000

# How many account ids are read from the ledger per request, bounded by one ledger
# message body as RECONCILIATION_ACCOUNT_LOOKUP_BATCH is. Only UNITS_IN_ISSUE is
# read here — one account per fund — so it is effectively never reached. Bounded
# anyway: a truncated read looks exactly like a fund with nothing in issue, which
# would let an incomplete file tie.
SNAPSHOT_ACCOUNT_LOOKUP_BATCH=8189

# Bucket the daily snapshot and its manifest are written to. A SEPARATE bucket from
# the contribution and valuation ones: a different producer (the close itself), a
# different retention, and contents that are every participant's position rather
# than one employer's file. Provisioned by the `object-store-buckets` one-shot in
# docker-compose.yml — eod-job never creates a bucket.
# Required: the service fails to start with this unset, naming the variable.
SNAPSHOT_BUCKET=eod-snapshots

# Prefix every snapshot object is stored under, before /dt=YYYY-MM-DD/. No leading
# or trailing slash — startup fails on one. Configurable so a single bucket can hold
# more than one environment's output without either being able to name the other's key.
SNAPSHOT_KEY_PREFIX=snapshots

# Largest compressed positions file the pass will build. The file is assembled in
# memory, so this is the memory bound; past it the pass fails naming both numbers
# rather than dying of an OutOfMemoryError that says nothing about which of the
# close's five steps was running. 1 GiB.
SNAPSHOT_MAX_OBJECT_BYTES=1073741824

# Explicit per-call timeout for the snapshot's object-store calls. Generous next to
# an API's: this writes a file that can run to tens of megabytes, and a timeout tuned
# for a small object would fail the close on a large book rather than on a real fault.
SNAPSHOT_OBJECT_STORE_CALL_TIMEOUT=30s

# When in the business day the scheduled close may run: a local HH:MM in
# CALENDAR_ZONE, before CALENDAR_CUTOFF_TIME. Empty (the default, and production's
# setting) means every sweep above and below runs on every tick, as it always has.
# Set, reconciliation, custodian reconciliation, the snapshot and sign-off for a
# business date wait until this time on that date, and the first three stop once the
# date is signed off. The demo overlays set 17:00: `demo-tools advance` lands on 09:00
# and the day's payroll and NAV strike follow within minutes, so an unwindowed sweep
# would snapshot the date before its business reached the book.
CLOSE_WINDOW_START=

# Sign-off (Task 7.5a, ADR-0021). When internal reconciliation, custodian
# reconciliation and the dense snapshot have all passed for a business date, eod-job
# writes workflow.close_signoff and publishes close.signed-off.v1 — the trigger for
# the statement fan-out, which is a separate service (statement-worker, Task 7.5b).
# This is eod-job's event publication; it produces this one event and
# consumes nothing.

# RabbitMQ connection — the broker services publish to. Required:
# the service fails to start with this unset, naming the variable.
SIGNOFF_AMQP_HOST=rabbitmq
SIGNOFF_AMQP_PORT=5672
SIGNOFF_AMQP_USERNAME=funds
SIGNOFF_AMQP_PASSWORD=funds_dev_pass
SIGNOFF_AMQP_VHOST=/

# How often the sign-off pass runs. Once a day is enough; a shorter interval
# re-checks gates that have not changed and re-publishes the event only if the last
# publish was not confirmed.
SIGNOFF_POLL_INTERVAL=1h

# How long to wait for publisher confirm on close.signed-off.v1 before giving up and
# letting the next sweep retry.
SIGNOFF_PUBLISH_CONFIRM_TIMEOUT=30s

# ---------------------------------------------------------------------------
# statement-worker — the statement worker pool (Task 7.5b, ADR-0022)
#
# Reads POSTGRES_*, OBJECT_STORE_* and SNAPSHOT_BUCKET above (read-only: the
# scheduler reads Task 7.4's snapshot objects, it never writes them). Holds no
# LEDGER_* or CALENDAR_* configuration at all — every number it renders comes
# from Task 7.4's snapshot files and workflow.allotment joined to
# reference.fund_nav (ADR-0022 §4), never the ledger or a BusinessCalendar.
#
# Two roles in one deployable: a scheduler consuming eod-job's
# close.signed-off.v1 (Task 7.5a) and N workers consuming this service's own
# statement.jobs.v1 via RabbitMQ.
# ---------------------------------------------------------------------------

# RabbitMQ connection. Required:
# the service fails to start with this unset, naming the variable.
STATEMENT_AMQP_HOST=rabbitmq
STATEMENT_AMQP_PORT=5672
STATEMENT_AMQP_USERNAME=funds
STATEMENT_AMQP_PASSWORD=funds_dev_pass
STATEMENT_AMQP_VHOST=/

# How many statement.jobs.v1 messages one instance drains concurrently.
STATEMENT_WORKER_CONCURRENCY=6

# How long the scheduler waits for RabbitMQ to confirm job
# messages before treating the publish as failed and leaving close.signed-off.v1
# unacknowledged for redelivery. Generous: a month can be 250,000 messages.
STATEMENT_PUBLISH_CONFIRM_TIMEOUT=60s

# How often the settlement sweep compares the Redis completion counter against
# each RUNNING period's expected_count (ADR-0022 §3).
STATEMENT_SETTLEMENT_SWEEP_INTERVAL=5s

# The completion counter's own Redis connection — separate variables from
# REDIS_URL (cash-receipt idempotency) and NAV_CACHE_REDIS_URL (the NAV warm
# start): a different producer, a different key space, a different service.
# Required: the service fails to start with either unset.
STATEMENT_REDIS_URL=redis://redis:6379
STATEMENT_REDIS_PASSWORD=funds_dev_pass
STATEMENT_REDIS_COMMAND_TIMEOUT=1s

# How long a period's completion-counter keys survive in Redis before they may
# be reclaimed. Long enough for an operator to read the prior month's progress
# for the whole of the next close cycle.
STATEMENT_COUNTER_TTL=45d

# Bucket rendered statements are written to. A SEPARATE bucket from
# SNAPSHOT_BUCKET: a different producer (statement-worker, not the close), and
# this service holds no credential that can write to eod-job's bucket.
# Provisioned by the object-store-buckets one-shot in docker-compose.yml.
# Required: the service fails to start with this unset, naming the variable.
STATEMENT_BUCKET=statement-objects

# Explicit per-call timeout for the statement object-store's calls. Generous: the
# same client opens a Task 7.4 snapshot object and holds the stream while it is
# gzip-decompressed and parsed — up to a million lines — and the AWS SDK applies
# this timeout to the whole streaming call, not just the initial response. A
# value sized for the quick statement-object PUT would fail a large snapshot
# read as an object-store outage before the parse ever finishes.
STATEMENT_OBJECT_STORE_CALL_TIMEOUT=5m

# ---------------------------------------------------------------------------
# Observability stack (Task 11.1) -- OTel Collector, Prometheus, Grafana,
# Tempo, Loki, under the `observability` compose profile (also in `all`).
# These variables are port mappings and retention only; nothing here is a
# secret except the Grafana admin password, which follows the same
# local-dev-default pattern as every other credential in this file.
# ---------------------------------------------------------------------------

# OTel Collector OTLP receiver port mappings (gRPC, HTTP), its own
# self-telemetry port -- the metrics about the Collector itself, always live
# regardless of whether any service has been instrumented yet -- and its
# health_check extension. The extension has no compose-level healthcheck
# consuming it (the image is distroless -- see the service's own comment in
# docker-compose.yml), so this port mapping exists purely so a human can
# `curl http://localhost:$OTEL_COLLECTOR_HEALTH_CHECK_PORT/` from the host.
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_SELF_METRICS_PORT=8888
OTEL_COLLECTOR_HEALTH_CHECK_PORT=13133

# Prometheus port mapping
PROMETHEUS_PORT=9090

# How long Prometheus keeps scraped samples. Short for local development --
# this is a demo/dev stack, never a durable metrics archive.
PROMETHEUS_RETENTION=15d

# Tempo query API port mapping (grpc/http OTLP ingest ports are internal-only,
# reached by the Collector as tempo:4317). Retention is NOT a variable here --
# unlike Prometheus, Tempo has no retention flag, only its config file
# (tempo/tempo.yaml's compactor.compaction.block_retention); a variable here
# with no wiring to that file would look configurable and not be.
TEMPO_PORT=3200

# Loki HTTP API port mapping. Retention is likewise config-file-only
# (loki/loki-config.yaml's limits_config.retention_period), same reason as
# Tempo above.
LOKI_PORT=3100

# Task 11.2: where every service exports its own spans and domain metrics
# (application.yaml's management.otlp.tracing.endpoint /
# management.otlp.metrics.export.url both derive from this one value). No
# service ever names Prometheus, Tempo or Loki directly -- the Collector is
# the only address configured, matching Task 11.1's own acceptance criterion.
# Port 4318 (HTTP), not 4317 (gRPC): every service's OTLP transport is
# configured as http, and the OTel Java agent's own default protocol
# (http/protobuf, contribution-api's Dockerfile only) expects this port too.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Grafana web UI port mapping. Not 3000 -- TigerBeetle already holds that host
# port (TIGERBEETLE_PORT above); Grafana's container-side port is unaffected.
GRAFANA_PORT=3001

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_pass

# ---------------------------------------------------------------------------
# Demo clock (Task D.1, phase-D-demo.md) -- contribution-api, allotment-job,
# valuation-api, eod-job, statement-worker and balance-api each read this to
# decide which java.time.Clock bean to build.
# ---------------------------------------------------------------------------

# false (the default): every service builds StorableClock.systemUTC() and
# reference.demo_clock is never read at all. true: each service instead polls
# reference.demo_clock once a second and offsets its own idea of "now" by
# whatever demo-tools' `advance` command has dialed forward (Task D.2) --
# this is how "a day passes" in the demo without touching TigerBeetle's own
# timestamps (see phase-D-demo.md Sec "Time, honestly"). MUST NEVER be true in
# production: the Kustomize local overlay is the only place this platform
# ever sets it, never the prod overlay and never this file's own default.
DEMO_CLOCK_ENABLED=false
