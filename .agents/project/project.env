# What this repository decides for the lane harness. Committed; no secrets. The harness reads it from origin/main.
HARNESS_VERSION=0.1.0          # the agent-harness version this project runs on
PROJECT=fondaria
LANE_NAMES="claude gemini"

# This repository is public. Only issues, comments and PRs by these GitHub logins ever reach a lane.
TRUSTED_AUTHORS="enrique-esquivel"

# owner: every PR that passed cross-review and CI gets `ready-to-merge`, and the owner merges it.
# lanes: such a PR is merged by the supervisor unless it touches OWNER_RE. Participants' money is at stake: owner.
MERGE_POLICY=owner
OWNER_RE='^(\.agents/|\.github/|\.githooks/|\.claude/|AGENTS\.md$|CLAUDE\.md$|docs/|contracts/|libs/(ledger-|rules-engine|db-migrations|valuation|platform-common)|infrastructure/|pom\.xml$)'

# Paths only a phase:harness issue may change. PROTECTED_ALLOW_<phase> opens some of them to another phase.
PROTECTED_RE='^(\.agents/|\.github/|\.githooks/|\.claude/|AGENTS\.md$|CLAUDE\.md$|docs/ENGINEERING-RULES\.md$)'
PROTECTED_ALLOW_stack='^(docs/ENGINEERING-RULES\.md|\.github/workflows/(ci|nightly-rebuild)\.yml)$'
PROTECTED_ALLOW_baseline='^\.github/workflows/(ci|nightly-rebuild)\.yml$'

# CI job names that must be green, ';'-separated, and the paths ci.yml ignores (paths-ignore).
CI_CHECKS='Run verification and format checks;Validate the Flyway migration tree'
CI_IGNORE_RE='^docs/|\.md$'

# An added line that disables, skips or filters out a test.
TEST_GLOBS='*.java *.xml Makefile *.yml'
SKIP_RE='^\+.*(@Disabled|@EnabledIf|assumeTrue\(|assumeFalse\(|Assumptions\.|<skipTests>|<skip>true|testFailureIgnore|<excludedGroups>|excluded\.test\.groups>)'
