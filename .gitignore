# =========================================================================
# 1. AI, MACHINE LEARNING, & AGENT SPECIFIC (Python/Vector/Prompts)
# =========================================================================
# Local AI Agent configs (Cursor, Claude, VS Code, Laravel Boost)
.cursor/
.cursorignore
.cursor_mcp.json
.claudignore
# Claude Code: per-machine settings and agent worktrees (.claude/settings.json stays tracked)
.claude/settings.local.json
.claude/worktrees/
*AI-instructions.md

# Python Virtual Environments (if using Python scripts for data/training)
venv/
.venv/
env/
__pycache__/
*.py[cod]

# AI Models, Weights, and Datasets (Never commit large binaries)
*.onnx
*.bin
*.pt
*.pth
*.gguf
*.h5
*.tflite
models/
weights/
datasets/
data/*.csv
data/*.jsonl

# Vector Database Local Storage
.chroma/
milvus/
pinecone/
.qdrant/

# Scratchpad
.ai-scratchpad/

# =========================================================================
# 2. SECURITY & ENVIRONMENT VARIABLES
# =========================================================================
# Block API keys (OpenAI, Anthropic, HuggingFace) and DB credentials
.env
.env.*
.env.local
token.json
*.pem
*.p12
*.jks
*.pkcs12
*.key
secrets/

# Ensure you always track the safe template file
!.env.example

# Local kind cluster's private keys and certificates (gateway TLS, Linkerd trust
# anchor + issuer), generated by infrastructure/k8s/bootstrap/local-secrets.sh
# and never committed
infrastructure/k8s/overlays/local/generated/
# ...and the GKE load-test environment's (infrastructure/gke/secrets.sh), plus
# the id of the project infrastructure/gke/up.sh created
infrastructure/k8s/overlays/gke/generated/
infrastructure/gke/.state

# =========================================================================
# 3. JAVA & BUILD TOOLS (Maven / Gradle) & DOMAIN SPECIFIC
# =========================================================================
# Compiled Java files
*.class
*.log
*.ctxt

# Packaged outputs
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz

# Maven
target/
.jqwik-database
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
release.properties

# Gradle
.gradle/
build/
/gradlew.bat

# Storage & Infrastructure
infrastructure/compose/data/
*.tigerbeetle

# Demo tooling (Task D.2, phase-D-demo.md): generated files, never committed
demo/out/

